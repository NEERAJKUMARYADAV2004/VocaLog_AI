// 1. Tell Prisma what to generate
generator client {
  provider = "prisma-client-js"
  
}

// 2. Tell Prisma we are using PostgreSQL
datasource db {
  provider = "postgresql"
}

// 3. Transcript Model (Core Requirement)
model Transcript {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
}

// 4. Voice Logs
model VoiceLog {
  id        String   @id @default(cuid())
  text      String   // This will hold the Gemini transcription
  createdAt DateTime @default(now())
}